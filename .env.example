# Application Settings
FLASK_ENV=development
FLASK_SECRET_KEY=your-super-secret-key-change-in-production
PORT=5000
DEBUG=True

# Database
DATABASE_URL=sqlite:///scam_prevention.db

# AI Model Settings
MODEL_PATH=./data/models/
CONFIDENCE_THRESHOLD=0.75
SCAM_ALERT_THRESHOLD=0.85

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500

# Email Alerts (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@yourcompany.com

# Webhook Alerts (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# API Keys (Optional external services)
VIRUSTOTAL_API_KEY=your-virustotal-api-key
GOOGLE_SAFE_BROWSING_KEY=your-google-safe-browsing-key
